# Copy this file to .env.local and fill in your Firebase web app configuration
# (Firebase console -> Project settings -> Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the local Firebase emulators instead of the real project
# (start them with `npx firebase-tools emulators:start`).
VITE_FIREBASE_EMULATORS=false
